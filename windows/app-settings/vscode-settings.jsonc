{
	// -------------------------------------- GENERAL SETTINGS ---------------------------------------

	"editor.accessibilitySupport": "off",
	"editor.bracketPairColorization.enabled": false,
	"editor.codeActionsOnSave": {
		"source.organizeImports": true
	},
	"editor.codeLens": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "JetBrains Mono",
	"editor.fontLigatures": true,
	"editor.fontSize": 16,
	"editor.formatOnSave": true,
	"editor.inlayHints.enabled": "offUnlessPressed",
	"editor.insertSpaces": false,
	"editor.linkedEditing": true,
	"editor.minimap.enabled": false,
	"editor.rulers": [80, 100],
	"editor.stickyScroll.enabled": true,
	"editor.tabSize": 2,

	"files.eol": "\n",

	"git.enableCommitSigning": true,

	"scm.repositories.sortOrder": "name",

	"search.exclude": {
		"**/.__pycache__": true,
		"**/.git": true,
		"**/.husky": true,
		"**/.mypy_cache": true,
		"**/.nyc_output": true,
		"**/.venv": true,
		"**/.vscode": true,
		"**/coverage": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/package-lock.json": true,
		"**/pnpm-lock.yaml": true,
		"**/venv": true,
		"**/yarn.lock": true
	},
	"search.searchOnType": false,

	"window.autoDetectColorScheme": true,
	"window.zoomLevel": 1,

	"workbench.colorTheme": "Tomorrow Night Eighties",
	"workbench.editor.pinnedTabSizing": "compact",
	"workbench.preferredDarkColorTheme": "Tomorrow Night Eighties",
	"workbench.preferredLightColorTheme": "GitHub Light Default",
	"workbench.settings.editor": "json",
	"workbench.sideBar.location": "right",

	// ------------------------------------ OS-SPECIFIC SETTINGS -------------------------------------

	// Linux
	"editor.selectionClipboard": false,

	"window.titleBarStyle": "custom",

	// Windows
	"terminal.external.windowsExec": "wt",

	// --------------------------------- LANGUAGE-SPECIFIC SETTINGS ----------------------------------

	"css.validate": false,

	"javascript.updateImportsOnFileMove.enabled": "always",

	"js/ts.implicitProjectConfig.checkJs": true,

	"less.validate": false,

	"scss.validate": false,

	"typescript.updateImportsOnFileMove.enabled": "always",

	// ------------------------------------- EXTENSION SETTINGS --------------------------------------

	// Code Runner
	"code-runner.clearPreviousOutput": true,
	"code-runner.runInTerminal": true,
	"code-runner.saveFileBeforeRun": true,

	// GitLens
	"gitlens.codeLens.enabled": false,
	"gitlens.hovers.currentLine.over": "annotation",
	"gitlens.plusFeatures.enabled": false,
	"gitlens.showWelcomeOnInstall": false,
	"gitlens.showWhatsNewAfterUpgrades": false,
	"gitlens.statusBar.enabled": false,

	// Prettier
	"prettier.endOfLine": "lf",
	"prettier.printWidth": 100,
	"prettier.tabWidth": 4,
	"prettier.useTabs": true,

	// Stylelint
	"stylelint.validate": ["css", "scss"],

	// TODO Highlight
	"todohighlight.exclude": [
		"**/*.min.*",
		"**/*.map",
		"**/.__pycache__/**",
		"**/.git/**",
		"**/.husky/**",
		"**/.mypy_cache/**",
		"**/.nyc_output/**",
		"**/.venv/**",
		"**/.vscode/**",
		"**/coverage/**",
		"**/dist/**",
		"**/node_modules/**",
		"**/package-lock.json/**",
		"**/pnpm-lock.yaml/**",
		"**/venv/**",
		"**/yarn.lock/**"
	],
	"todohighlight.include": [
		"**/*.css",
		"**/*.html",
		"**/*.js",
		"**/*.jsonc",
		"**/*.py",
		"**/*.scss",
		"**/*.ts",
		"**/*.tsx"
	]
}
