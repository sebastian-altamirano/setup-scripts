{
	"author": "Sebastián Altamirano",
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@eslint/markdown": "^7.1.0",
		"@tsconfig/strictest": "^2.0.5",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.2.1",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.5",
		"prettier": "3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=10.0.0"
		},
		"runtime": {
			"name": "node",
			"version": "^22.0.0"
		}
	},
	"license": "MIT",
	"name": "dotfiles",
	"scripts": {
		"check": "tsc",
		"format": "pnpm run format:fish && pnpm run format:powershell && pnpm run format:prettier",
		"format:fish": "fish scripts/fish-format-project.fish",
		"format:powershell": "pwsh -File scripts/powershell-format-project.ps1",
		"format:prettier": "prettier --write --ignore-unknown .",
		"lint": "pnpm run lint:bash && pnpm run lint:js && pnpm run lint:powershell",
		"lint:bash": "fish scripts/bash-lint-project.fish",
		"lint:js": "eslint",
		"lint:powershell": "pwsh -File scripts/powershell-lint-project.ps1",
		"prepare": "husky"
	},
	"type": "module",
	"version": "1.0.0"
}
