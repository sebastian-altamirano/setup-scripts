{
	"author": "Sebastián Altamirano",
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@eslint/markdown": "^7.5.0",
		"@tsconfig/strictest": "^2.0.6",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.9.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"prettier": "3.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=10.0.0"
		},
		"runtime": {
			"name": "node",
			"version": "^24.12.0"
		}
	},
	"license": "MIT",
	"name": "setup-scripts",
	"scripts": {
		"check": "tsc",
		"format": "pnpm run format:bash && pnpm run format:fish && pnpm run format:powershell && pnpm run format:prettier",
		"format:bash": "pwsh -File scripts/code-quality.ps1 -Action format -Type bash",
		"format:fish": "pwsh -File scripts/code-quality.ps1 -Action format -Type fish",
		"format:powershell": "pwsh -File scripts/code-quality.ps1 -Action format -Type powershell",
		"format:prettier": "prettier --write --ignore-unknown .",
		"lint": "pnpm run lint:bash && pnpm run lint:js && pnpm run lint:powershell",
		"lint:bash": "pwsh -File scripts/code-quality.ps1 -Action lint -Type bash",
		"lint:js": "eslint",
		"lint:powershell": "pwsh -File scripts/code-quality.ps1 -Action lint -Type powershell",
		"prepare": "husky"
	},
	"type": "module",
	"version": "1.0.0"
}
