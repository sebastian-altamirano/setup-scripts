{
	"settingsPaths": [
		{
			"resourceName": "fish",
			"destination": "~/.config/fish"
		},
		{
			"resourceName": ".gitconfig",
			"destination": "~/.gitconfig"
		},
		{
			"resourceName": "gpg-agent.conf",
			"destination": "~/.gnupg/gpg-agent.conf",
			"completionCommands": [["gpg-connect-agent", "reloadagent", "/bye"]]
		},
		{
			"resourceName": "ssh-config",
			"destination": "~/.ssh/config"
		}
	],
	"vscodeExtensions": [
		"dbaeumer.vscode-eslint",
		"eamodio.gitlens",
		"esbenp.prettier-vscode",
		"formulahendry.code-runner",
		"stylelint.vscode-stylelint"
	]
}
