{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"erasableSyntaxOnly": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"sourceMap": true,
		"target": "es2022",
		"verbatimModuleSyntax": true
	},
	"exclude": ["node_modules"],
	"include": ["**/*.d.ts", "**/*.js", "**/*.mjs", "**/*.ts"]
}
