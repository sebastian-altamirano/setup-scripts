[alias]
	aliases = config --get-regexp alias
	amend = commit --amend --date=now --no-edit
	br = branch
	brd = branch -D
	brl = branch -l
	brm = branch -m
	ci = commit
	cim = commit -m
	co = checkout
	cob = checkout -b
	cp = cherry-pick
	l = log
	pl = pull
	ps = push
	st = status

[core]
	editor = nano

[init]
	defaultBranch = main

[pull]
	ff = true

[push]
	default = current
