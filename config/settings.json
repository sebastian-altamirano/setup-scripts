{
	"ubuntu": {
		"settingsPaths": [
			{
				"resourceName": "fish",
				"destination": "~/.config/fish"
			},
			{
				"resourceName": "gpg-agent.conf",
				"destination": "~/.gnupg/gpg-agent.conf",
				"completionCommands": [["gpg-connect-agent", "reloadagent", "/bye"]]
			},
			{
				"resourceName": "ssh-config",
				"destination": "~/.ssh/config"
			}
		],
		"vscodeExtensions": [
			"Codeium.codeium",
			"dbaeumer.vscode-eslint",
			"eamodio.gitlens",
			"esbenp.prettier-vscode",
			"formulahendry.code-runner",
			"stylelint.vscode-stylelint",
			"yoavbls.pretty-ts-errors"
		]
	},
	"windows": {
		"postInstallationInstructions": [
			"Copy the snippets from `/src/browser-snippets` into the browser where you want to use them.",
			"Enable 'File name extensions' and 'Hidden items' in the File Explorer options.",
			"Disable mouse acceleration.",
			"Change the mouse pointer scheme and/or size",
			"Increase the text size and/or display scale.",
			"Change the screen refresh rate to the maximum available value."
		],
		"quickAccessFolders": ["Github", "Notas", "Playground"],
		"settingsPaths": [
			{
				"resourceName": "csgo-autoexec.cfg",
				"destination": "${env:ProgramFiles(x86)}\\Steam\\steamapps\\common\\Counter-Strike Global Offensive\\csgo\\cfg\\autoexec.cfg",
				"postInstallationInstructions": "Configure the CSGO launch options in Steam to use the autoexec (see the first comment in the CFG)."
			},
			{
				"resourceName": "vscode-settings.jsonc",
				"destination": "$env:AppData\\Code\\User\\settings.json"
			},
			{
				"resourceName": "vscode-keybindings.jsonc",
				"destination": "$env:AppData\\Code\\User\\keybindings.json"
			},
			{
				"resourceName": "windows-terminal.json",
				"destination": "$env:LocalAppData\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json"
			}
		],
		"vscodeExtensions": [
			"github.github-vscode-theme",
			"jgclark.vscode-todo-highlight",
			"ms-vscode.Theme-TomorrowKit",
			"ms-vscode-remote.remote-wsl"
		]
	}
}
