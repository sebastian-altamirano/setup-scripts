{
	// -------------------------------------- GENERAL SETTINGS ---------------------------------------

	"accessibility.underlineLinks": true,

	"chat.editRequests": "hover",
	"chat.viewSessions.orientation": "stacked",

	"debug.breakpointsView.presentation": "tree",
	"debug.showVariableTypes": true,
	"debug.toolBarLocation": "commandCenter",

	"diffEditor.ignoreTrimWhitespace": false,

	"editor.accessibilitySupport": "off",
	"editor.bracketPairColorization.enabled": false,
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.codeLens": true,
	"editor.detectIndentation": true,
	"editor.fontFamily": "'MonaspiceNe Nerd Font', monospace",
	"editor.fontLigatures": "'calt', 'cv01' 2, 'cv11', 'cv31', 'ss01', 'ss02', 'ss03', 'ss04', 'ss07', 'ss09', 'liga'",
	"editor.fontSize": 16,
	"editor.guides.bracketPairs": "active",
	"editor.guides.indentation": true,
	"editor.inlayHints.enabled": "offUnlessPressed",
	"editor.inlineSuggest.syntaxHighlightingEnabled": true,
	"editor.linkedEditing": true,
	"editor.minimap.enabled": false,
	"editor.pasteAs.preferences": ["text.updateImports", "text.updateLinks.markdown"],
	"editor.rulers": [80, 100],
	"editor.stickyScroll.enabled": true,
	"editor.tabSize": 2,
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": ["comment", "string.quoted.docstring"],
				"settings": {
					"fontStyle": "italic"
				}
			}
		]
	},
	"editor.wordWrap": "off",
	"editor.wordWrapColumn": 100,

	"extensions.autoUpdate": "onlyEnabledExtensions",

	"files.defaultLanguage": "markdown",

	"git.addAICoAuthor": "off",
	"git.blame.editorDecoration.enabled": false,
	"git.blame.statusBarItem.enabled": false,
	"git.enableCommitSigning": true,

	"inlineChat.enableV2": true,

	"remote.autoForwardPortsSource": "hybrid",

	"scm.repositories.sortOrder": "name",

	"search.exclude": {
		"**/bun.lock": true,
		"**/package-lock.json": true,
		"**/pdm.lock": true,
		"**/pnpm-lock.yaml": true,
		"**/poetry.lock": true,
		"**/uv.lock": true,
		"**/yarn.lock": true
	},
	"search.searchOnTypeDebouncePeriod": 500,
	"search.useIgnoreFiles": true,

	"terminal.integrated.stickyScroll.enabled": false,

	"window.autoDetectColorScheme": true,
	"window.titleBarStyle": "custom",
	"window.zoomLevel": 1,
	"window.zoomPerWindow": false,

	"workbench.editor.empty.hint": "hidden",
	"workbench.editorAssociations": {
		"*.svg": "default"
	},
	"workbench.preferredDarkColorTheme": "GitHub Dark Dimmed",
	"workbench.preferredLightColorTheme": "GitHub Light Default",
	"workbench.settings.editor": "json",
	"workbench.sideBar.location": "right",

	// ------------------------------------ OS-SPECIFIC SETTINGS -------------------------------------

	// Linux
	"editor.selectionClipboard": false,

	// Windows
	"terminal.external.windowsExec": "wt",

	// --------------------------------- LANGUAGE-SPECIFIC SETTINGS ----------------------------------

	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[instructions]": {
		"editor.wordWrap": "bounded"
	},

	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[javascriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.wordWrap": "bounded"
	},

	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.wordWrap": "bounded"
	},

	"[markdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.quickSuggestions": {
			"comments": "off",
			"strings": "off",
			"other": "off"
		},
		"editor.suggestOnTriggerCharacters": false,
		"editor.wordWrap": "bounded"
	},

	"[plaintext]": {
		"editor.wordWrap": "bounded"
	},

	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},

	"go.inlayHints.assignVariableTypes": true,
	"go.inlayHints.compositeLiteralFields": true,
	"go.inlayHints.compositeLiteralTypes": true,
	"go.inlayHints.constantValues": true,
	"go.inlayHints.functionTypeParameters": true,
	"go.inlayHints.parameterNames": true,
	"go.inlayHints.rangeVariableTypes": true,
	"go.lintFlags": ["--fast"],

	"js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
	"js/ts.inlayHints.parameterNames.enabled": "all",
	"js/ts.inlayHints.parameterTypes.enabled": true,
	"js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
	"js/ts.inlayHints.variableTypes.enabled": true,
	"js/ts.implicitProjectConfig.checkJs": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",

	"python.analysis.aiCodeActions": {
		"generateDocstring": true,
		"generateSymbol": true,
		"implementAbstractClasses": true
	},
	"python.analysis.autoFormatStrings": true,
	"python.analysis.autoImportCompletions": true,
	"python.analysis.inlayHints.callArgumentNames": "all",
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.analysis.inlayHints.pytestParameters": true,
	"python.analysis.inlayHints.variableTypes": true,
	"python.terminal.shellIntegration.enabled": true,
	"python.analysis.showOnlyDirectDependenciesInAutoImport": true,
	"python.analysis.typeCheckingMode": "strict",

	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.inlayHints.enumMemberValues.enabled": true,
	"typescript.inlayHints.functionLikeReturnTypes.enabled": true,
	"typescript.inlayHints.parameterNames.enabled": "all",
	"typescript.inlayHints.parameterTypes.enabled": true,
	"typescript.inlayHints.propertyDeclarationTypes.enabled": true,
	"typescript.inlayHints.variableTypes.enabled": true,
	"typescript.preferences.preferTypeOnlyAutoImports": true,
	"typescript.updateImportsOnFileMove.enabled": "always",

	// ------------------------------------- EXTENSION SETTINGS --------------------------------------

	"code-runner.clearPreviousOutput": true,
	"code-runner.runInTerminal": true,
	"code-runner.saveFileBeforeRun": true,

	"github.copilot.enable": {
		"*": false
	},

	"gitlens.ai.enabled": false,
	"gitlens.codeLens.enabled": false,
	"gitlens.hovers.currentLine.over": "annotation",
	"gitlens.plusFeatures.enabled": false,
	"gitlens.rebaseEditor.openOnPausedRebase": false,
	"gitlens.showWhatsNewAfterUpgrades": false,
	"gitlens.statusBar.enabled": false,

	"prettier.endOfLine": "lf",
	"prettier.printWidth": 100,
	"prettier.requireConfig": true,
	"prettier.tabWidth": 4,
	"prettier.useEditorConfig": false,
	"prettier.useTabs": true,

	"todohighlight.exclude": [
		"**/__pycache__/**",
		"**/.git/**",
		"**/.husky/_/**",
		"**/.mypy_cache/**",
		"**/.nyc_output/**",
		"**/.venv/**",
		"**/*.min.*",
		"**/build/**",
		"**/coverage/**",
		"**/dist/**",
		"**/node_modules/**",
		"**/package-lock.json",
		"**/venv/**"
	],
	"todohighlight.include": [
		"**/*.bash",
		"**/*.cjs",
		"**/*.css",
		"**/*.fish",
		"**/*.go",
		"**/*.html",
		"**/*.jinja",
		"**/*.js",
		"**/*.json",
		"**/*.jsonc",
		"**/*.jsx",
		"**/*.md",
		"**/*.mdx",
		"**/*.mjs",
		"**/*.ps1",
		"**/*.psd1",
		"**/*.psm1",
		"**/*.py",
		"**/*.scss",
		"**/*.sh",
		"**/*.toml",
		"**/*.ts",
		"**/*.tsx",
		"**/*.txt",
		"**/*.yaml",
		"**/*.yml"
	],

	"yaml.disableSchemaDetection": ["**/.github/workflows/*.yml", "**/.github/workflows/*.yaml"]
}
