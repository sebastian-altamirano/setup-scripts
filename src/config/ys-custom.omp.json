{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"blocks": [
		{
			"alignment": "left",
			"segments": [
				{
					"foreground": "p:green",
					"properties": {
						"fetch_version": true
					},
					"style": "plain",
					"template": "{{ if .Error }}{{ .Error }}{{ else }}Node v{{ .Full }}{{ end }}",
					"type": "node"
				},
				{
					"foreground": "p:yellow",
					"properties": {
						"fetch_version": false
					},
					"style": "plain",
					"template": "{{ if .Error }}{{ .Error }}{{ else }}Python v{{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}{{ end }}",
					"type": "python"
				}
			],
			"type": "prompt"
		},
		{
			"alignment": "left",
			"newline": true,
			"segments": [
				{
					"foreground": "p:brightBlue",
					"style": "plain",
					"template": "# ",
					"type": "text"
				},
				{
					"foreground": "p:red",
					"style": "plain",
					"template": " % ",
					"type": "root"
				},
				{
					"style": "plain",
					"template": "<p:cyan>{{ .UserName }}</> <p:brightBlack>@</> <p:green>{{ .HostName }}</> ",
					"type": "session"
				},
				{
					"foreground": "p:brightYellow",
					"properties": {
						"style": "full"
					},
					"style": "plain",
					"template": "<p:brightBlack>in </>{{ .Path }} ",
					"type": "path"
				},
				{
					"properties": {
						"fetch_status": true
					},
					"style": "plain",
					"template": "<p:brightBlack>on</> <p:white>git:</><p:cyan>{{ .HEAD }}</>{{ if .Working.Changed }}<p:red> x</>{{ end }} ",
					"type": "git"
				},
				{
					"foreground": "p:brightBlack",
					"style": "plain",
					"template": "[{{ .CurrentDate | date .Format }}]",
					"type": "time"
				},
				{
					"foreground": "p:red",
					"style": "plain",
					"template": " C:{{ if gt .Code 0 }}{{ .Code }}{{ end }} ",
					"type": "status"
				}
			],
			"type": "prompt"
		},
		{
			"alignment": "left",
			"newline": true,
			"segments": [
				{
					"foreground": "p:brightRed",
					"style": "plain",
					"template": "$",
					"type": "text"
				}
			],
			"type": "prompt"
		}
	],
	"final_space": true,
	"palettes": {
		"list": {
			"github-dark-dimmed": {
				"background": "#1C2128",
				"black": "#545D68",
				"blue": "#539BF5",
				"brightBlack": "#636E7B",
				"brightBlue": "#6CB6FF",
				"brightCyan": "#56D4DD",
				"brightGreen": "#6BC46D",
				"brightMagenta": "#DCBDFB",
				"brightRed": "#FF938A",
				"brightWhite": "#CDD9E5",
				"brightYellow": "#DAAA3F",
				"cyan": "#39C5CF",
				"foreground": "#ADBAC7",
				"green": "#57AB5A",
				"magenta": "#B083F0",
				"red": "#F47067",
				"white": "#909DAB",
				"yellow": "#C69026"
			},
			"github-light": {
				"background": "#F6F8FA",
				"black": "#24292F",
				"blue": "#0969DA",
				"brightBlack": "#57606A",
				"brightBlue": "#218BFF",
				"brightCyan": "#3192AA",
				"brightGreen": "#1A7F37",
				"brightMagenta": "#A475F9",
				"brightRed": "#A40E26",
				"brightWhite": "#8C959F",
				"brightYellow": "#633C01",
				"cyan": "#1B7C83",
				"foreground": "#1F2328",
				"green": "#116329",
				"magenta": "#8250DF",
				"red": "#CF222E",
				"white": "#6E7781",
				"yellow": "#4D2D00"
			}
		},
		"template": "github-light"
	},
	"version": 3
}
